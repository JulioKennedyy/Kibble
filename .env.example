# Kibble — environment variables
# Reference for local development and hosting configuration.
# Never commit a real .env file.

# ── Frontend (Vite) ──────────────────────────────────────────────
# Override the default backend URL if you deploy the API elsewhere.
VITE_API_URL=http://localhost:8000
# Free hosts can take close to a minute to wake after being idle.
VITE_API_TIMEOUT_MS=75000

# ── Backend ──────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call the API.
KIBBLE_CORS_ORIGINS=http://localhost:5173
# Public API safeguards. Defaults shown below.
KIBBLE_RATE_LIMIT_PER_MINUTE=120
KIBBLE_MAX_TOTAL_INPUT_CHARS=500000
KIBBLE_MAX_REQUEST_BODY_BYTES=2100000

# Kibble does not call provider APIs and needs no API keys.
