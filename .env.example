# Kibble — environment variables
# Copy this file to .env (or .env.local for the frontend) and fill in your values.
# NEVER commit .env files with real keys to version control.

# ── Frontend (Vite) ──────────────────────────────────────────────
# Override the default backend URL if you deploy the API elsewhere.
# VITE_API_URL=http://localhost:8000

# ── Backend ──────────────────────────────────────────────────────
# Kibble does NOT call any provider APIs on your behalf —
# it is a local token estimation tool only.
# No API keys are required or stored by the backend.
#
# If you extend Kibble to call providers directly, add your keys here:
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...
